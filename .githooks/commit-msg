#!/bin/sh
# Removes assistant authorship lines from the commit message.
root=$(git rev-parse --show-toplevel) || exit 0
pattern="$root/.github/checks/attribution-pattern.txt"
[ -f "$pattern" ] || exit 0
tmp=$(mktemp) || exit 1
grep -viE -f "$pattern" "$1" > "$tmp" || true
cat "$tmp" > "$1"
rm -f "$tmp"
